{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRoleChaining",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "Resource": "*"
    },
    {
      "Sid": "DenyServiceLinkedRoleChanges",
      "Effect": "Deny",
      "Action": [
        "iam:CreateServiceLinkedRole",
        "iam:DeleteServiceLinkedRole"
      ],
      "Resource": "*"
    }
  ]
}
