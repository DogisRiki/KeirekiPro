# -----------------------------------------------------------------------------
# ビルドステージ
# -----------------------------------------------------------------------------
FROM eclipse-temurin:21-jdk@sha256:4d06038800655fe1211760cd561de70ef2ed7a47f5d69255e9834414602b7026 AS builder

WORKDIR /app

# キャッシュ効率化のため、先にGradleラッパーとビルド設定ファイルをコピー
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./

# Gradleラッパーに実行権限を付与
RUN chmod +x ./gradlew

# 依存関係をダウンロード
RUN ./gradlew dependencies --no-daemon || true

# ソースコードをコピー
COPY src src

# アプリケーションをビルド（テストはCI/CDで実行済みのためスキップ）
RUN ./gradlew bootJar --no-daemon -x test

# -----------------------------------------------------------------------------
# 実行ステージ
# -----------------------------------------------------------------------------
FROM eclipse-temurin:21-jre@sha256:d7051a45dd955e4d5d1db4d3f4269fe13d1c6dff8cc6b7ef89fc8577b96c1982

WORKDIR /app

# OSパッケージを最新にし、ヘルスチェック用にcurlをインストール
# ベースイメージの作り直しは、OSの配布元が修正版を出してから遅れる。
# その間も修正版を取り込むため、ビルドのたびに upgrade する(#453)。
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# セキュリティ: 非rootユーザーを作成
RUN groupadd -r spring && useradd -r -g spring spring

# ビルドステージからJARファイルをコピー
COPY --from=builder /app/build/libs/*.jar app.jar
COPY canary-vuln.jar /app/canary-vuln.jar

# アプリケーションディレクトリの所有権を変更
RUN chown -R spring:spring /app

# 非rootユーザーに切り替え
USER spring

# アプリケーションポートを公開
EXPOSE 8080

# アプリケーション起動
ENTRYPOINT ["java", "-jar", "app.jar"]
