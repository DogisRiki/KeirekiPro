# -----------------------------------------------------------------------------
# ビルドステージ
# -----------------------------------------------------------------------------
FROM eclipse-temurin:21-jdk@sha256:0a3f329821dcadf54b2a3033a15e2e9f007069a9db43d7f51897e6b80e726b07 AS builder

WORKDIR /app

# キャッシュ効率化のため、先にGradleラッパーとビルド設定ファイルをコピー
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./

# Gradleラッパーに実行権限を付与
RUN chmod +x ./gradlew

# 依存関係をダウンロード
RUN ./gradlew dependencies --no-daemon || true

# ソースコードをコピー
COPY src src

# アプリケーションをビルド（テストはCI/CDで実行済みのためスキップ）
RUN ./gradlew bootJar --no-daemon -x test

# -----------------------------------------------------------------------------
# 実行ステージ
# -----------------------------------------------------------------------------
FROM eclipse-temurin:21-jre@sha256:18bb4a91a3dea3f03ee31d3755af34dfb40f904fc77ab56cdc2f092e32fff9c2

WORKDIR /app

# OSパッケージを最新にし、ヘルスチェック用にcurlをインストール
# ベースイメージの作り直しは、OSの配布元が修正版を出してから遅れる。
# その間も修正版を取り込むため、ビルドのたびに upgrade する(#453)。
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# ベースイメージ(Ubuntu 26.04)には、OSパッケージの外で /usr/bin/pebble(Go製)が入っている。
# アプリは java で直接起動し pebble を使わないため、Go の脆弱性を持ち込まないよう消す(#554)。
RUN rm -f /usr/bin/pebble

# セキュリティ: 非rootユーザーを作成
RUN groupadd -r spring && useradd -r -g spring spring

# ビルドステージからJARファイルをコピー
COPY --from=builder /app/build/libs/*.jar app.jar

# アプリケーションディレクトリの所有権を変更
RUN chown -R spring:spring /app

# 非rootユーザーに切り替え
USER spring

# VERSION は、ログの service.version に書く版である。出荷のワークフローがコミットの SHA を渡す。
# application.yaml は環境変数 APP_VERSION を読むので、受け取った版を APP_VERSION に入れる。
# 渡されないときは、application.yaml の既定と同じ unknown になる
ARG VERSION=unknown
ENV APP_VERSION=${VERSION}

# アプリケーションポートを公開
EXPOSE 8080

# アプリケーション起動
ENTRYPOINT ["java", "-jar", "app.jar"]
