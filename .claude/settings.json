{
    "env": {
        "MSYS2_ARG_CONV_EXCL": "*"
    },
    "permissions": {
        "allow": [
            "Bash(bash .claude/scripts/parallel/run-check.sh *)",
            "Bash(bash .claude/scripts/parallel/ui.sh *)",
            "Bash(bash .claude/scripts/parallel/session.sh *)",
            "Bash(docker compose exec -w /home/spring/app backend ./gradlew flywayInfo)",
            "Bash(docker compose up -d *)",
            "Bash(docker compose ps *)",
            "Bash(docker ps *)",
            "Bash(git status *)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Bash(git diff)",
            "Bash(git log *)",
            "Bash(git branch *)",
            "Bash(git switch *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push -u origin *)",
            "Bash(git push origin *)",
            "Bash(git fetch *)",
            "Bash(git merge origin/*)",
            "Bash(git rev-parse *)",
            "Bash(gh pr create *)",
            "Bash(gh pr view *)",
            "Bash(gh pr list *)",
            "Bash(gh pr checks *)",
            "Bash(gh pr diff *)",
            "Bash(gh pr comment *)",
            "Bash(gh pr edit *)",
            "Bash(gh pr merge --auto *)",
            "Bash(gh pr update-branch *)",
            "Bash(gh issue view *)",
            "Bash(gh issue list *)",
            "Bash(gh issue comment *)",
            "Bash(gh issue create *)",
            "Bash(gh issue close *)",
            "Bash(gh run view *)",
            "Bash(gh run list *)",
            "Bash(gh run watch *)",
            "Bash(gh label create *)"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git push origin main)",
            "Bash(git push -u origin main)",
            "Bash(git push origin HEAD:main)",
            "Bash(git push -u origin HEAD:main)",
            "Bash(git push origin main:main)",
            "Bash(rm -rf *)",
            "Bash(rm -fr *)",
            "Bash(terraform apply *)",
            "Bash(docker compose exec -w /workspace terraform terraform apply *)",
            "Bash(gh workflow run release.yaml *)",
            "Bash(gh workflow run terraform-apply.yaml *)",
            "Edit(.github/**)",
            "Write(.github/**)",
            "Edit(.claude/settings.json)",
            "Write(.claude/settings.json)",
            "Edit(.claude/settings.local.json)",
            "Write(.claude/settings.local.json)",
            "Edit(.claude/hooks/**)",
            "Write(.claude/hooks/**)",
            "Edit(frontend/eslint.config.js)",
            "Write(frontend/eslint.config.js)",
            "Edit(frontend/vite.config.ts)",
            "Write(frontend/vite.config.ts)",
            "Edit(backend/gradle/quality.gradle)",
            "Write(backend/gradle/quality.gradle)",
            "Edit(backend/config/**)",
            "Write(backend/config/**)",
            "Edit(backend/src/test/java/com/example/keirekipro/unit/architecture/**)",
            "Write(backend/src/test/java/com/example/keirekipro/unit/architecture/**)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-registry.sh\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-registry.sh\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-main.sh\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-encoding.sh\"",
                        "timeout": 15
                    }
                ]
            },
            {
                "matcher": "SubagentHandback",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-spec-review.sh\"",
                        "timeout": 20
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-verify-before-stop.sh\"",
                        "timeout": 20
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-spec-review-before-stop.sh\"",
                        "timeout": 30
                    }
                ]
            }
        ],
        "UserPromptExpansion": [
            {
                "matcher": "kiro-spec-design|kiro-spec-tasks|kiro-impl",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-spec-review.sh\"",
                        "timeout": 20
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-spec-review.sh\"",
                        "timeout": 20
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-registry.sh\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "spec-reviewer",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-spec-review.sh\"",
                        "timeout": 20
                    }
                ]
            }
        ]
    }
}
